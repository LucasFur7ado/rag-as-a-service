# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.turbo/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
worker-configuration.d.ts

# Env files (never commit real secrets)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
.DS_Store
Thumbs.db
*.tsbuildinfo
.vercel

# Retrieval evaluation harness (apps/web/eval)
# Raw run output and the embedding cache are reproducible artifacts, not source.
# Copy a report.md out of results/ if you want to keep one.
apps/web/eval/results/
apps/web/eval/.cache/

# BEIR benchmark datasets (pnpm eval:beir).
# Third-party corpora, ~9 MB each, published and versioned upstream — so a run
# is reproduced by naming the dataset and checking the corpus fingerprint the
# report prints, not by vendoring the files. Unzip a download into either of
# these locations and the harness finds it.
/nfcorpus/
/scifact/
/fiqa/
/trec-covid/
/arguana/
apps/web/eval/beir/data/

# Local Claude Code settings (machine-specific; not shared with collaborators).
.claude/settings.local.json

# Local eval corpus and the datasets built from it.
# The PDFs are third-party or institutional documents that are not ours to
# redistribute, and the datasets quote them verbatim in `answerText`. The
# tracked corpus (*.md) and datasets/starter.* are synthetic and stay in git,
# so the harness still runs on a fresh clone.
apps/web/eval/corpus/*.pdf
apps/web/eval/corpus-excluded/
apps/web/eval/datasets/llamados.*
apps/web/eval/datasets/uav-papers.*
