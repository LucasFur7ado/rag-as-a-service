{
	// Infrastructure-as-code for the RAG-as-a-Service backend API worker.
	// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rag-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// --- Workers AI (embeddings via @cf/baai/bge-m3; later re-ranking/LLM) ----
	// Note: `wrangler dev` runs Workers AI against the real (remote) API even in
	// local mode, so inference calls incur normal Workers AI usage.
	"ai": {
		"binding": "AI"
	},
	// --- KV namespace (read-optimized cache of API-key hashes for auth) ------
	// TODO: replace the placeholder id with a real namespace id from:
	//   wrangler kv namespace create RAG_KV
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "d65715fcbed2405c92e77bcd4dbe8575"
		},
		{
			"binding": "RAG_KV",
			"id": "d65715fcbed2405c92e77bcd4dbe8575",
			"remote": false
		}
	],
	// --- D1 (collections/documents metadata, Drizzle-managed schema) ---------
	// Create remotely with:
	//   wrangler d1 create rag-db          # paste database_id below
	// Apply migrations (generated by drizzle-kit into ./migrations):
	//   wrangler d1 migrations apply rag-db --local    # local dev
	//   wrangler d1 migrations apply rag-db --remote   # production
	// `wrangler dev` emulates D1 locally by default (no remote resource needed).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rag-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// --- R2 (raw uploaded documents) -----------------------------------------
	// Create remotely with:
	//   wrangler r2 bucket create rag-raw-docs
	// `wrangler dev` emulates R2 locally by default.
	"r2_buckets": [
		{
			"binding": "RAW_DOCS",
			"bucket_name": "rag-raw-docs"
		}
	],
	// --- Plain-text vars ------------------------------------------------------
	// WEB_ORIGIN: origin(s) of the web SPA allowed by CORS, comma-separated.
	// PINECONE_INDEX / PINECONE_INDEX_HOST: the Pinecone index used for vectors.
	//   The host is shown on the index page in the Pinecone console; the index
	//   must be created with dimension 1024 (bge-m3) and metric `cosine`.
	//   (PINECONE_API_KEY is a secret — see the Secrets section below.)
	// Override per environment; use `wrangler deploy --var ...` or envs.
	"vars": {
		"WEB_ORIGIN": "http://localhost:3000",
		"PINECONE_INDEX": "rag-as-service",
		"PINECONE_INDEX_HOST": "https://rag-as-service-xwgkypj.svc.aped-4627-b74a.pinecone.io"
	},
	// --- Queue (async ingestion trigger) --------------------------------------
	// Producer + consumer both bound to the same queue. Uploads (and reingest)
	// enqueue an IngestMessage; the `queue()` consumer in src/index.ts starts
	// one INGEST_WORKFLOW instance per message. Create the queues with:
	//   wrangler queues create ingest-queue
	//   wrangler queues create ingest-queue-dlq
	"queues": {
		"producers": [
			{
				"queue": "ingest-queue",
				"binding": "INGEST_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "ingest-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 3,
				"dead_letter_queue": "ingest-queue-dlq"
			}
		]
	},
	// --- Workflow (durable ingestion pipeline) --------------------------------
	// `IngestWorkflow` (src/workflows/ingest.ts, re-exported from src/index.ts)
	// runs parse → chunk → embed → upsert → finalize as retryable steps.
	"workflows": [
		{
			"name": "ingest-workflow",
			"binding": "INGEST_WORKFLOW",
			"class_name": "IngestWorkflow"
		}
	],
	// --- Durable Object (per-API-key rate limiter) ----------------------------
	// `RateLimiter` (src/durable/ratelimiter.ts, re-exported from src/index.ts)
	// is an atomic per-key sliding-window counter — chosen over KV (eventually
	// consistent, per-key write caps) and the native rate-limit binding (fixed
	// limit/period, no per-key override or exact remaining/reset). SQLite-backed
	// class (free-tier compatible), though this DO keeps its counter in memory.
	"durable_objects": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"class_name": "RateLimiter"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RateLimiter"
			]
		}
	]
	// --- Secrets (set via `wrangler secret put <NAME>`, not committed) --------
	// CLERK_ISSUER, CLERK_AUTHORIZED_PARTY, PINECONE_API_KEY
	// For local dev, put them in apps/api/.dev.vars (git-ignored).
}