# apps/web (Next.js — static export, client-rendered SPA)
# Copy to `.env.local` (git-ignored) and fill in real values.
#
# These are baked into the bundle at BUILD time; set them before `next build`.
# They are PUBLIC by design (`NEXT_PUBLIC_` prefix) — never put secrets here.
# The web app runs no server code, so CLERK_SECRET_KEY is deliberately absent.

# From https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk catch-all sign-in / sign-up routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Where the web app finds the API worker (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8787
