# apps/web — the whole application (Next.js frontend + API route handlers).
# Copy to `.env.local` (git-ignored) and fill in real values.
#
# NEXT_PUBLIC_* vars are baked into the browser bundle and are PUBLIC by
# design. Everything else is server-only: read at request time inside route
# handlers, never shipped to the client. On Vercel, set them all under
# Project → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Public (browser) — safe to expose
# ---------------------------------------------------------------------------

# From https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk catch-all sign-in / sign-up routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Absolute API base URL used ONLY by the docs' copy-pasteable curl/Python
# samples and the "Try it" console. The dashboard itself calls the same-origin
# `/api` and needs no configuration. Set this to your deployed origin + /api.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Server-only — real secrets, never prefixed with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED connection string from the Neon dashboard (or
# the Vercel Neon integration, which sets this for you).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk Frontend API URL (the token issuer).
CLERK_ISSUER=https://your-app-name.clerk.accounts.dev

# REQUIRED. Origin(s) of the web app, comma-separated — matched against the
# session token's `azp` claim. Session auth FAILS CLOSED if this is unset:
# `iss` only proves the token came from your Clerk instance, `azp` proves it
# was issued for YOUR frontend.
CLERK_AUTHORIZED_PARTY=http://localhost:3000

# Google AI Studio key — powers answer generation. Free tier, no billing
# required: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Cloudflare Workers AI — powers EMBEDDINGS (@cf/baai/bge-m3) over the REST
# API. The model only: no Worker is deployed and no `wrangler` is involved.
# Account ID: Cloudflare dashboard → Workers & Pages → Account ID.
# Token: My Profile → API Tokens → use the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Pinecone: create a serverless index with dimension 1024 and metric `cosine`.
# The host is shown on the index page in the Pinecone console.
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=rag-index
PINECONE_INDEX_HOST=your-index-host.svc.your-region.pinecone.io

# Vercel Blob read-write token. Created automatically when you add a Blob store
# to the project (Storage → Create → Blob, access: PRIVATE). Needed locally
# only if you want uploads to work in `next dev`.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Shared secret for the daily retention cron. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`; the endpoint refuses to run without a
# match, so leaving this unset disables the cron rather than exposing it.
CRON_SECRET=generate_a_long_random_string

# OPTIONAL. Absolute base URL advertised as the primary server in the generated
# OpenAPI spec. Falls back to the request origin + /api.
# PUBLIC_API_URL=https://your-app.vercel.app/api

# OPTIONAL. Extra origins allowed to call the API cross-origin, comma-separated.
# The dashboard is same-origin, so this is only for browser-based API-key
# clients hosted elsewhere. Empty (closed) by default.
# API_CORS_ORIGINS=https://some-other-app.example.com
